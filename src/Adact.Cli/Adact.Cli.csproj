<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>adact</AssemblyName>
    <RootNamespace>Adact.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Adact.Engine\Adact.Engine.csproj" />
    <ProjectReference Include="..\Adact.Mcp.Common\Adact.Mcp.Common.csproj" />
    <ProjectReference Include="..\Adact.Mcp.Stdio\Adact.Mcp.Stdio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- HttpHost.BuildApplication を Adact.Mcp.Http.Tests から呼ぶため、internal を可視化する。 -->
    <InternalsVisibleTo Include="Adact.Mcp.Http.Tests" />
  </ItemGroup>

</Project>
