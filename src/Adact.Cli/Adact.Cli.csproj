<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>adact</AssemblyName>
    <RootNamespace>Adact.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta5.25306.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Adact.Cli.Core\Adact.Cli.Core.csproj" />
    <ProjectReference Include="..\Adact.Cli.Server\Adact.Cli.Server.csproj" />
    <ProjectReference Include="..\Adact.Mcp.Stdio\Adact.Mcp.Stdio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Adact.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Adact.Cli.Core\Skills\**\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Skills\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
