<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>adact</AssemblyName>
    <RootNamespace>Adact.Cli</RootNamespace>
    <Version>0.1.0</Version>
    <EnableShortGitInformationalVersion>true</EnableShortGitInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Adact.Cli.Core\Adact.Cli.Core.csproj" />
    <ProjectReference Include="..\Adact.Cli.Server\Adact.Cli.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Adact.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Adact.Cli.Core\Skills\**\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Skills\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
