<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\Adact.Cli.Versioning.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Adact.Cli.Client</RootNamespace>
    <AssemblyName>adact</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.7" />
    <ProjectReference Include="..\Adact.Cli.Core\Adact.Cli.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Adact.Cli.Core\Skills\**\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Skills\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
