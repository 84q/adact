<UserControl x:Class="SampleApp.Tabs.RichTextTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="10">
        <TextBlock Text="Rich Text: TextPattern comparison between RichTextBox, FlowDocumentScrollViewer, and plain TextBox." FontWeight="Bold" />
        <Grid Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Editable RichTextBox with paragraphs, bold, italic, list, and link-like text." />
                <RichTextBox x:Name="RichDocumentBox" Height="230" AcceptsTab="True" AutomationProperties.AutomationId="RichText_RichTextBox_Document" AutomationProperties.Name="Rich Text Document Box">
                    <FlowDocument>
                        <Paragraph FontSize="18" FontWeight="Bold">UIA TextPattern sample heading</Paragraph>
                        <Paragraph>This paragraph contains <Bold>bold text</Bold>, <Italic>italic text</Italic>, and <Underline>underlined link-style text</Underline>.</Paragraph>
                        <List>
                            <ListItem><Paragraph>First rich list item</Paragraph></ListItem>
                            <ListItem><Paragraph>Second rich list item</Paragraph></ListItem>
                        </List>
                        <Paragraph>Use inspect to compare TextPattern document range and selected ranges.</Paragraph>
                    </FlowDocument>
                </RichTextBox>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Read-only FlowDocumentScrollViewer (TextPattern + ScrollPattern candidate)." />
                <FlowDocumentScrollViewer Height="230" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="RichText_FlowDocumentScrollViewer_ReadOnlyDocument" AutomationProperties.Name="Read Only Flow Document Viewer">
                    <FlowDocument>
                        <Paragraph FontSize="16" FontWeight="Bold">Read-only document</Paragraph>
                        <Paragraph>This document is intentionally long enough to require scrolling in small windows.</Paragraph>
                        <Paragraph>Line 1: Sample text range observation.</Paragraph>
                        <Paragraph>Line 2: Another paragraph for TextPattern.</Paragraph>
                        <Paragraph>Line 3: More content for ScrollPattern observation.</Paragraph>
                        <Paragraph>Line 4: End of read-only document.</Paragraph>
                    </FlowDocument>
                </FlowDocumentScrollViewer>
            </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,5">
            <Button Content="Select Heading" Click="SelectHeadingButton_Click" AutomationProperties.AutomationId="RichText_Button_SelectHeading" AutomationProperties.Name="Select Rich Text Heading Button" />
            <Button Content="Copy Selection" Margin="5,0,0,0" Command="ApplicationCommands.Copy" CommandTarget="{Binding ElementName=RichDocumentBox}" AutomationProperties.AutomationId="RichText_Button_CopySelection" AutomationProperties.Name="Copy Rich Text Selection Button" />
            <TextBlock x:Name="SelectionStatusText" Text="Selected text status: none" Margin="10,3,0,0" AutomationProperties.AutomationId="RichText_TextBlock_SelectionStatus" AutomationProperties.Name="Rich Text Selection Status" />
        </StackPanel>
        <TextBlock Text="Plain TextBox baseline (ValuePattern/TextPattern depending on WPF peer):" Margin="0,10,0,5" />
        <TextBox Text="Plain multi-line text baseline&#x0a;Second line for comparison&#x0a;Third line" AcceptsReturn="True" Height="80" AutomationProperties.AutomationId="RichText_TextBox_PlainBaseline" AutomationProperties.Name="Plain Text Pattern Baseline Text Box" />
    </StackPanel>
    </ScrollViewer>
</UserControl>
