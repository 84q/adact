<UserControl x:Class="SampleApp.Tabs.BasicControlsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="10">
        <TextBlock Text="Name:" Margin="0,5" />
        <TextBox x:Name="NameInput"
                 AutomationProperties.AutomationId="BasicControls_TextBox_NameInput"
                 AutomationProperties.Name="Name Input" />

        <TextBlock Text="Password:" Margin="0,10,0,5" />
        <PasswordBox x:Name="PasswordInput"
                     AutomationProperties.AutomationId="BasicControls_PasswordBox_PasswordInput"
                     AutomationProperties.Name="Password Input" />

        <Button x:Name="SubmitButton"
                Content="Submit"
                Margin="0,10"
                AutomationProperties.AutomationId="BasicControls_Button_Submit"
                AutomationProperties.Name="Submit Button"
                ToolTip="Click to submit the form"
                Click="SubmitButton_Click" />

        <CheckBox x:Name="EnableFeature"
                  Content="Enable Feature"
                  Margin="0,5"
                  AutomationProperties.AutomationId="BasicControls_CheckBox_EnableFeature"
                  AutomationProperties.Name="Enable Feature" />

        <StackPanel Orientation="Horizontal" Margin="0,5">
            <RadioButton x:Name="OptionA"
                         Content="Option A"
                         GroupName="Options"
                         AutomationProperties.AutomationId="BasicControls_RadioButton_OptionA"
                         AutomationProperties.Name="Option A" />
            <RadioButton x:Name="OptionB"
                         Content="Option B"
                         GroupName="Options"
                         Margin="10,0,0,0"
                         AutomationProperties.AutomationId="BasicControls_RadioButton_OptionB"
                         AutomationProperties.Name="Option B" />
        </StackPanel>

        <TextBlock Text="Value:" Margin="0,10,0,5" />
        <Slider x:Name="ValueSlider"
                Minimum="0"
                Maximum="100"
                Value="50"
                 AutomationProperties.AutomationId="BasicControls_Slider_Value"
                 AutomationProperties.Name="Value Slider" />
        <TextBlock Text="RangeValuePattern: horizontal, vertical, and disabled sliders expose min/max/value and enabled state." />
        <TextBlock x:Name="ValueSliderValueLabel"
                   AutomationProperties.AutomationId="BasicControls_TextBlock_ValueSliderCurrent"
                   AutomationProperties.Name="Value Slider Current Value" />
        <Slider x:Name="FineGrainedSlider"
                Minimum="-10"
                Maximum="10"
                TickFrequency="0.5"
                IsSnapToTickEnabled="True"
                Value="2.5"
                AutomationProperties.AutomationId="BasicControls_Slider_FineGrained"
                AutomationProperties.Name="Fine Grained Slider" />
        <Slider x:Name="VerticalSlider"
                Orientation="Vertical"
                Height="90"
                Minimum="0"
                Maximum="5"
                Value="3"
                AutomationProperties.AutomationId="BasicControls_Slider_Vertical"
                AutomationProperties.Name="Vertical Range Slider" />
        <Slider IsEnabled="False"
                Minimum="0"
                Maximum="100"
                Value="25"
                AutomationProperties.AutomationId="BasicControls_Slider_Disabled"
                AutomationProperties.Name="Disabled Range Slider" />

        <TextBlock Text="Status:" Margin="0,10,0,5" />
        <ProgressBar x:Name="StatusProgressBar"
                     Height="20"
                     Minimum="0"
                     Maximum="100"
                     Value="0"
                      AutomationProperties.AutomationId="BasicControls_ProgressBar_Status"
                      AutomationProperties.Name="Status Progress Bar" />
        <CheckBox x:Name="IndeterminateProgressToggle"
                  Content="Indeterminate progress"
                  Margin="0,5"
                  AutomationProperties.AutomationId="BasicControls_CheckBox_IndeterminateProgress"
                  AutomationProperties.Name="Indeterminate Progress Toggle"
                  Checked="IndeterminateProgressToggle_Changed"
                  Unchecked="IndeterminateProgressToggle_Changed" />

        <TextBlock Text="TogglePattern: two-state ToggleButton and three-state CheckBox." Margin="0,10,0,5" />
        <ToggleButton Content="Toggle Me"
                      Width="120"
                      HorizontalAlignment="Left"
                      AutomationProperties.AutomationId="BasicControls_ToggleButton_TwoState"
                      AutomationProperties.Name="Two State Toggle Button" />
        <CheckBox Content="Three State CheckBox"
                  IsThreeState="True"
                  IsChecked="{x:Null}"
                  Margin="0,5"
                  AutomationProperties.AutomationId="BasicControls_CheckBox_ThreeState"
                  AutomationProperties.Name="Three State Check Box" />

        <TextBlock Text="Text / Value variants: read-only and disabled TextBox for fill failure diagnostics." Margin="0,10,0,5" />
        <TextBox Text="Read-only value can be inspected but should not be fillable."
                 IsReadOnly="True"
                 AutomationProperties.AutomationId="BasicControls_TextBox_ReadOnly"
                 AutomationProperties.Name="Read Only Text Box" />
        <TextBox Text="Disabled value remains visible but not enabled."
                 IsEnabled="False"
                 Margin="0,5"
                 AutomationProperties.AutomationId="BasicControls_TextBox_Disabled"
                 AutomationProperties.Name="Disabled Text Box" />

        <Label x:Name="StatusLabel"
               Content="Ready"
               Margin="0,10"
               AutomationProperties.AutomationId="BasicControls_Label_Status"
               AutomationProperties.Name="Status Label" />
    </StackPanel>
    </ScrollViewer>
</UserControl>
