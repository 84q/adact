<UserControl x:Class="SampleApp.Tabs.TreeMenuTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <Menu DockPanel.Dock="Top" AutomationProperties.AutomationId="TreeMenu_Menu_Patterns" AutomationProperties.Name="Tree and Menu Pattern Menu">
            <MenuItem Header="Options" AutomationProperties.AutomationId="TreeMenu_MenuItem_Options">
                <MenuItem Header="Checkable option" IsCheckable="True" IsChecked="True" AutomationProperties.AutomationId="TreeMenu_MenuItem_CheckableOption" AutomationProperties.Name="Checkable Menu Option" />
                <MenuItem Header="Mode" AutomationProperties.AutomationId="TreeMenu_MenuItem_Mode">
                    <MenuItem Header="Mode A" IsCheckable="True" IsChecked="True" AutomationProperties.AutomationId="TreeMenu_MenuItem_ModeA" AutomationProperties.Name="Radio Menu Mode A" />
                    <MenuItem Header="Mode B" IsCheckable="True" AutomationProperties.AutomationId="TreeMenu_MenuItem_ModeB" AutomationProperties.Name="Radio Menu Mode B" />
                </MenuItem>
                <MenuItem Header="Level 1" AutomationProperties.AutomationId="TreeMenu_MenuItem_Level1">
                    <MenuItem Header="Level 2" AutomationProperties.AutomationId="TreeMenu_MenuItem_Level2">
                        <MenuItem Header="Level 3 Action" AutomationProperties.AutomationId="TreeMenu_MenuItem_Level3Action" AutomationProperties.Name="Deep Menu Action" />
                    </MenuItem>
                </MenuItem>
            </MenuItem>
        </Menu>
        <TextBlock DockPanel.Dock="Top" Text="TreeView: mixed expanded/collapsed, deep hierarchy, many nodes. Menu: Toggle/ExpandCollapse/Invoke and context menu popup." Margin="0,8" FontWeight="Bold" />
        <TreeView x:Name="MainTreeView"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  AutomationProperties.AutomationId="TreeMenu_TreeView_Main"
                  AutomationProperties.Name="Main Tree View">
            <TreeView.ContextMenu>
                <ContextMenu AutomationProperties.AutomationId="TreeMenu_ContextMenu_Main"
                             AutomationProperties.Name="Main Context Menu">
                    <MenuItem Header="Expand" AutomationProperties.AutomationId="TreeMenu_ContextMenu_Expand" />
                    <MenuItem Header="Collapse" AutomationProperties.AutomationId="TreeMenu_ContextMenu_Collapse" />
                    <Separator />
                     <MenuItem Header="Delete" AutomationProperties.AutomationId="TreeMenu_ContextMenu_Delete" />
                     <MenuItem Header="Context Check" IsCheckable="True" AutomationProperties.AutomationId="TreeMenu_ContextMenu_Checkable" AutomationProperties.Name="Checkable Context Menu Item" />
                 </ContextMenu>
             </TreeView.ContextMenu>
         </TreeView>
    </DockPanel>
</UserControl>
