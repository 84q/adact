<UserControl x:Class="SampleApp.Tabs.AsyncDelayTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="10">
        <TextBlock Text="Async / Delay: determinate progress changes, cancel enabled state changes, and result elements appear after completion." FontWeight="Bold" />
        <Button x:Name="StartButton"
                Content="Start Long Task (5s)"
                Margin="0,5"
                AutomationProperties.AutomationId="AsyncDelay_Button_StartLongTask"
                AutomationProperties.Name="Start Long Task Button"
                Click="StartButton_Click" />
        <Button x:Name="CancelButton"
                Content="Cancel Task"
                IsEnabled="False"
                Margin="0,5"
                AutomationProperties.AutomationId="AsyncDelay_Button_CancelTask"
                AutomationProperties.Name="Cancel Task Button"
                Click="CancelButton_Click" />
        <ProgressBar x:Name="TaskProgressBar"
                      Height="20"
                      Margin="0,10"
                      IsIndeterminate="False"
                      Minimum="0"
                      Maximum="100"
                      AutomationProperties.AutomationId="AsyncDelay_ProgressBar_Task"
                      AutomationProperties.Name="Task Progress Bar" />
        <Label x:Name="StatusLabel"
               Content="Idle"
               AutomationProperties.AutomationId="AsyncDelay_Label_Status"
               AutomationProperties.Name="Task Status Label" />
        <ListBox x:Name="AsyncResultsListBox"
                 Height="100"
                 Margin="0,10"
                 AutomationProperties.AutomationId="AsyncDelay_ListBox_CompletedResults"
                 AutomationProperties.Name="Async Completed Results List Box" />
        <DataGrid x:Name="AsyncResultsDataGrid"
                  Height="120"
                  AutoGenerateColumns="True"
                  CanUserAddRows="False"
                  Visibility="Collapsed"
                  AutomationProperties.AutomationId="AsyncDelay_DataGrid_CompletedResults"
                  AutomationProperties.Name="Async Completed Results Data Grid" />
    </StackPanel>
</UserControl>
