<UserControl x:Class="SampleApp.Tabs.DragDropTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SampleApp.Tabs">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="10">
        <TextBlock Text="Drag/drop baseline: standard WPF drag-drop behavior. Custom controls below are placeholders, not DragPattern / DropTargetPattern providers." FontWeight="Bold" />
        <Grid Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Source ListBox (drag items)" />
                <ListBox x:Name="SourceListBox" Height="150" PreviewMouseMove="SourceListBox_PreviewMouseMove" AutomationProperties.AutomationId="DragDrop_ListBox_Source" AutomationProperties.Name="Drag Drop Source List Box" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Target ListBox (drop target)" />
                <ListBox x:Name="TargetListBox" Height="150" AllowDrop="True" Drop="TargetListBox_Drop" AutomationProperties.AutomationId="DragDrop_ListBox_Target" AutomationProperties.Name="Drag Drop Target List Box" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Reorderable ListBox" />
                <ListBox x:Name="ReorderListBox" Height="150" AllowDrop="True" PreviewMouseMove="ReorderListBox_PreviewMouseMove" Drop="ReorderListBox_Drop" AutomationProperties.AutomationId="DragDrop_ListBox_Reorderable" AutomationProperties.Name="Reorderable Drag Drop List Box" />
            </StackPanel>
        </Grid>
        <Border x:Name="DropZone" Height="90" AllowDrop="True" BorderBrush="DarkBlue" BorderThickness="2" Background="#FFEAF3FF" Drop="DropZone_Drop" AutomationProperties.AutomationId="DragDrop_Border_FileDropZone" AutomationProperties.Name="File Drop Style Zone">
            <TextBlock Text="Drop zone: drop list items here; snapshot should show status below." HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock x:Name="DragDropStatusText" Text="Drag/drop status: idle" Margin="0,8" AutomationProperties.AutomationId="DragDrop_TextBlock_Status" AutomationProperties.Name="Drag Drop Status Text" />

        <TextBlock Text="Placeholder custom peers for comparison only: inspect should not report DragPattern or DropTargetPattern from these controls." Margin="0,15,0,5" FontWeight="Bold" />
        <StackPanel Orientation="Horizontal">
            <local:CustomDragSourceControl Width="210" Height="52" Margin="0,0,10,0" AutomationProperties.AutomationId="DragDrop_Placeholder_DragSourceComparison" AutomationProperties.Name="Placeholder Drag Source Comparison" AutomationProperties.HelpText="Placeholder custom peer for standard WPF drag-drop comparison; does not expose DragPattern." />
            <local:CustomDropTargetControl Width="230" Height="52" AutomationProperties.AutomationId="DragDrop_Placeholder_DropTargetComparison" AutomationProperties.Name="Placeholder Drop Target Comparison" AutomationProperties.HelpText="Placeholder custom peer for standard WPF drag-drop comparison; does not expose DropTargetPattern." />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>
