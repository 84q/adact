<UserControl x:Class="SampleApp.Tabs.DynamicUITab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="10">
        <StackPanel Orientation="Horizontal" Margin="0,5">
            <Button x:Name="AddButton"
                    Content="Add TextBox"
                    Margin="0,0,5,0"
                    AutomationProperties.AutomationId="Dynamic_Button_AddTextBox"
                    AutomationProperties.Name="Add TextBox Button"
                    Click="AddButton_Click" />
            <Button x:Name="RemoveButton"
                    Content="Remove Last"
                    Margin="0,0,5,0"
                    AutomationProperties.AutomationId="Dynamic_Button_RemoveLast"
                    AutomationProperties.Name="Remove Last Button"
                    Click="RemoveButton_Click" />
            <Button x:Name="ClearButton"
                    Content="Clear All"
                    AutomationProperties.AutomationId="Dynamic_Button_ClearAll"
                    AutomationProperties.Name="Clear All Button"
                    Click="ClearButton_Click" />
        </StackPanel>
        <ItemsControl x:Name="DynamicItemsControl" Margin="0,10">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBox Text="{Binding Text}"
                             Margin="0,5,0,0"
                             AutomationProperties.AutomationId="{Binding AutomationId}"
                             AutomationProperties.Name="{Binding AutomationName}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
