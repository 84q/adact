<Window x:Class="SampleApp.CustomDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADACT SampleApp - Custom Dialog"
        Height="200"
        Width="400"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="Enter your name:" Margin="0,0,0,5" />
        <TextBox x:Name="NameTextBox" AutomationProperties.AutomationId="CustomDialog_TextBox_Name" AutomationProperties.Name="Name Text Box" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" Width="75" Margin="0,0,10,0" Click="OkButton_Click" AutomationProperties.AutomationId="CustomDialog_Button_OK" AutomationProperties.Name="OK Button" />
            <Button Content="Cancel" Width="75" Click="CancelButton_Click" AutomationProperties.AutomationId="CustomDialog_Button_Cancel" AutomationProperties.Name="Cancel Button" />
        </StackPanel>
    </StackPanel>
</Window>
