<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Exclude>[Adact.*.Tests]*,[xunit.*]*,[Microsoft.*]*,[System.*]*,[FlaUI.*]*,[ModelContextProtocol.*]*,[AutoFixture.*]*,[Moq.*]*,[Castle.*]*</Exclude>
          <ExcludeByFile>**/tests/**/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
